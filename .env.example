# Copy to .env (never commit .env). Real secrets live in the runtime secret manager
# (Railway variables / Supabase Vault), never in code or in the frontend.

# --- Mode -------------------------------------------------------------------
# DEV | PAPER | LIVE. LIVE additionally requires LIVE_TRADING_ENABLED=true.
TRADING_MODE=DEV
LIVE_TRADING_ENABLED=false
GLOBAL_KILL_SWITCH=false

# --- Paths --------------------------------------------------------------------
DATA_DIR=data/parquet
REPORTS_DIR=reports

# --- Supabase (backend services only; service role key never reaches the browser) --
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Broker: Trading 212 (separate keys per environment, IP-restricted) -------
T212_DEMO_API_KEY=
T212_DEMO_API_SECRET=
T212_LIVE_API_KEY=
T212_LIVE_API_SECRET=

# --- AI analyst (OpenAI Platform, separate billing from ChatGPT; set a budget) -
OPENAI_API_KEY=
OPENAI_MODEL_CHEAP=
OPENAI_MODEL_STRONG=
