# Copy to .env (never commit .env). Real secrets live in the runtime secret manager
# (Railway variables / Supabase Vault), never in code or in the frontend.

# --- Mode -------------------------------------------------------------------
# DEV | PAPER | LIVE. LIVE additionally requires LIVE_TRADING_ENABLED=true.
TRADING_MODE=DEV
LIVE_TRADING_ENABLED=false
GLOBAL_KILL_SWITCH=false

# --- Paths --------------------------------------------------------------------
DATA_DIR=data/parquet
REPORTS_DIR=reports

# --- Supabase (backend services only; service role key never reaches the browser) --
SUPABASE_URL=https://nzeuzxtpqrsvyvpxaugz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Broker: Trading 212 (separate keys per environment, IP-restricted) -------
T212_DEMO_API_KEY=
T212_DEMO_API_SECRET=
T212_LIVE_API_KEY=
T212_LIVE_API_SECRET=

# --- AI analyst (OpenAI Platform, separate billing from ChatGPT; set a budget) -
# Only proposes hypotheses for the Research Lab; never sees broker keys nor trades.
# Model: OPENAI_MODEL_STRONG, else OPENAI_MODEL_CHEAP, else gpt-5-mini.
OPENAI_API_KEY=
OPENAI_MODEL_CHEAP=
OPENAI_MODEL_STRONG=

# --- Alpaca (US stocks/ETFs: real-time IEX data + years of 1-minute history) ---
# Free account at https://alpaca.markets -> Paper Trading -> API keys. Paper keys are enough:
# the trader only reads market data; orders are simulated locally (PAPER).
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# --- Binance (crypto) ---------------------------------------------------------
# Not needed: market data is public and orders are simulated (PAPER). A future LIVE adapter would
# use a key with trading permission, NO withdrawal permission and an IP whitelist.

# --- Notifications (optional) ----------------------------------------------------
# Where to tell you that the paper account passed (or lost) the go-live gate.
# Phone push: install the ntfy app, subscribe to a hard-to-guess topic and put
# https://ntfy.sh/<that-topic> here. Slack/Discord incoming webhooks also work.
NOTIFY_WEBHOOK_URL=
